# PRISTOLOV_CORE V1 production environment template
#
# Copy this file to the server-side environment file used by systemd, for example:
# /etc/pristolov/pristolov.env
#
# Do not commit real production secrets.

# Required.
# PostgreSQL is recommended for public V1 deployment.
# SQLite is local/emergency only and should not be the default for public play.
DATABASE_URL=postgresql+psycopg2://pristolov_app:<password>@127.0.0.1:5432/pristolov_v1

# Required for public VPS deployment.
# When set, FastAPI blocks /dev/* and /gold/* unless requests include:
# X-Admin-Token: <token>
#
# If ADMIN_ROUTE_TOKEN is empty or missing, /dev/* and /gold/* remain open for
# local/dev compatibility. Deploying publicly without this token is a no-go.
ADMIN_ROUTE_TOKEN=<long-random-admin-route-token>

# Not currently read by app/config.py.
# Keep these out of production unless a future runtime patch explicitly supports them.
# APP_ENV=production
# ENVIRONMENT=production
# BASE_URL=https://example.com
# PUBLIC_BASE_URL=https://example.com
