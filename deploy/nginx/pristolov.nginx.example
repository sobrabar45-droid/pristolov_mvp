server {
    listen 80;
    server_name <DOMAIN>;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <DOMAIN>;

    # Configure these paths for your certificate provider.
    ssl_certificate /etc/letsencrypt/live/<DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMAIN>/privkey.pem;

    client_max_body_size 25m;

    location /dev/tv-screen/ {
        return 404;
    }

    location /dev/ {
        # Browser-friendly admin access:
        # the operator enters Basic Auth credentials in the browser,
        # then Nginx injects X-Admin-Token for the app-level /dev guard.
        auth_basic "PRISTOLOV operator";
        auth_basic_user_file /etc/nginx/.htpasswd_pristolov;

        proxy_set_header X-Admin-Token "<ADMIN_ROUTE_TOKEN>";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }

    location /gold/ {
        # Keep gold/economy controls behind the same browser-friendly gate.
        # Do not expose X-Admin-Token to public routes or client-side JS.
        auth_basic "PRISTOLOV operator";
        auth_basic_user_file /etc/nginx/.htpasswd_pristolov;

        proxy_set_header X-Admin-Token "<ADMIN_ROUTE_TOKEN>";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
}
